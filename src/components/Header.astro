---
import { languages, useTranslations, getLocalizedPath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentLangObj = languages[lang];
---

<header
  class="sticky top-0 z-50 w-full border-b border-theme-border/40 bg-theme-surface/95 backdrop-blur-md transition-colors duration-200"
>
  <nav
    class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
    aria-label="Primary Navigation"
  >
    <!-- Brand Logo + Title -->
    <a
      href={getLocalizedPath(lang)}
      aria-label={t('nav.brand')}
      class="group flex items-center gap-2.5 sm:gap-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#2A835F] shrink-0"
    >
      <div
        class="flex h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[#12544F] to-[#2A835F] text-[#F4F9F5] shadow-md transition-transform duration-200 group-hover:scale-105"
      >
        <svg
          class="h-6 w-6 sm:h-7 sm:w-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="3"></rect>
          <polygon points="10 9 15 12 10 15 10 9" fill="currentColor"></polygon>
        </svg>
      </div>
      <span class="text-lg sm:text-xl font-extrabold tracking-tight text-theme-text">
        {t('nav.brand')}
      </span>
    </a>

    <!-- =============================================================== -->
    <!-- DESKTOP NAVBAR CONTROLS (Visible on >= 1024px / lg:flex)        -->
    <!-- =============================================================== -->
    <div class="hidden lg:flex items-center gap-3">
      <!-- 1. 8-Language Dropdown Selector -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-btn"
          aria-label={t('nav.languageAria')}
          aria-expanded="false"
          aria-haspopup="true"
          class="flex h-11 px-3.5 items-center justify-center gap-2 rounded-xl border border-theme-border/60 bg-theme-bg/60 text-theme-text transition-all hover:border-[#2A835F] hover:bg-theme-pill focus:outline-none focus:ring-2 focus:ring-[#2A835F]"
        >
          <svg
            class="h-5 w-5 shrink-0 text-[#2A835F] dark:text-[#8BBB92]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="text-sm font-bold tracking-wide">
            {currentLangObj.flag} {currentLangObj.code}
          </span>
          <svg
            class="h-4 w-4 opacity-75 transition-transform duration-200"
            id="lang-chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Dropdown Menu (8 Languages) -->
        <div
          id="lang-dropdown-menu"
          role="menu"
          aria-orientation="vertical"
          class="invisible opacity-0 scale-95 pointer-events-none absolute right-0 mt-2 w-52 origin-top-right rounded-2xl border border-theme-border bg-theme-surface p-2 shadow-2xl transition-all duration-200 z-50"
        >
          <div class="grid grid-cols-1 gap-1">
            {
              Object.entries(languages).map(([code, info]) => {
                const isActive = code === lang;
                return (
                  <a
                    href={getLocalizedPath(code as Locale)}
                    role="menuitem"
                    class:list={[
                      'flex items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-colors',
                      isActive
                        ? 'bg-[#2A835F] text-white'
                        : 'text-theme-text hover:bg-theme-pill',
                    ]}
                  >
                    <span class="flex items-center gap-2.5">
                      <span class="text-base leading-none">{info.flag}</span>
                      <span>{info.name}</span>
                    </span>
                    <span
                      class:list={[
                        'text-xs font-bold uppercase px-1.5 py-0.5 rounded',
                        isActive ? 'bg-white/20 text-white' : 'text-theme-textSecondary opacity-75',
                      ]}
                    >
                      {info.code}
                    </span>
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>

      <!-- 2. Light/Dark Mode Toggle Button (Desktop) -->
      <button
        type="button"
        aria-label={t('nav.themeAria')}
        class="theme-toggle-trigger flex h-11 w-11 items-center justify-center rounded-xl border border-theme-border/60 bg-theme-bg/60 text-theme-text transition-all hover:border-[#2A835F] hover:bg-theme-pill focus:outline-none focus:ring-2 focus:ring-[#2A835F]"
      >
        <svg
          class="theme-icon-sun hidden h-5 w-5 text-[#8BBB92]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          class="theme-icon-moon h-5 w-5 text-[#12544F]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- 3. Install PWA Button ('Add to Home Screen') -->
      <button
        type="button"
        aria-label={t('nav.installPwaAria')}
        class="install-pwa-trigger flex h-11 px-4 items-center justify-center gap-2 rounded-xl border border-theme-border/60 bg-theme-bg/60 text-theme-text font-semibold text-sm transition-all hover:border-[#2A835F] hover:bg-theme-pill focus:outline-none focus:ring-2 focus:ring-[#2A835F]"
      >
        <svg
          class="h-5 w-5 shrink-0 text-[#2A835F] dark:text-[#8BBB92]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
          <line x1="12" y1="18" x2="12.01" y2="18"></line>
          <path d="M12 7v6"></path>
          <path d="M9.5 10.5 12 13l2.5-2.5"></path>
        </svg>
        <span class="whitespace-nowrap">{t('nav.installPwa')}</span>
      </button>

      <!-- 4. CTA Button: 'Support the Developer' -->
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('nav.supportDevAria')}
        class="btn-support-dev flex h-11 px-4 items-center justify-center gap-2 rounded-xl font-bold text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-[#8BBB92]"
      >
        <svg
          class="h-5 w-5 shrink-0 text-white"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
          <path d="M10 12.5c0-.8.7-1.5 1.5-1.5s1.5.7 1.5 1.5c0 1.5-3 3-3 3s-3-1.5-3-3c0-.8.7-1.5 1.5-1.5s1.5.7 1.5 1.5z" fill="currentColor" stroke="none"></path>
        </svg>
        <span class="whitespace-nowrap">{t('nav.supportDev')}</span>
      </a>
    </div>

    <!-- =============================================================== -->
    <!-- MOBILE & TABLET TOGGLE BAR (Visible on < 1024px / lg:hidden)    -->
    <!-- =============================================================== -->
    <div class="flex lg:hidden items-center gap-2">
      <!-- Quick Theme Toggle Icon (48x48px touch target) -->
      <button
        type="button"
        aria-label={t('nav.themeAria')}
        class="theme-toggle-trigger flex h-12 w-12 items-center justify-center rounded-xl border border-theme-border/60 bg-theme-bg/60 text-theme-text transition-all hover:border-[#2A835F] hover:bg-theme-pill focus:outline-none focus:ring-2 focus:ring-[#2A835F]"
      >
        <svg
          class="theme-icon-sun hidden h-6 w-6 text-[#8BBB92]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          class="theme-icon-moon h-6 w-6 text-[#12544F]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile & Tablet Menu Toggle Icon Button (48x48px touch target) -->
      <button
        type="button"
        id="mobile-menu-toggle-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-tablet-drawer"
        class="flex h-12 w-12 items-center justify-center rounded-xl border border-theme-border/60 bg-[#2A835F] text-white shadow-sm transition-all hover:bg-[#12544F] focus:outline-none focus:ring-2 focus:ring-[#8BBB92]"
      >
        <!-- Hamburger Icon -->
        <svg
          id="menu-icon-open"
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <!-- Close (X) Icon -->
        <svg
          id="menu-icon-close"
          class="hidden h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- =============================================================== -->
  <!-- COLLAPSIBLE DRAWER FOR MOBILE & TABLET (< 1024px / lg:hidden)   -->
  <!-- =============================================================== -->
  <div
    id="mobile-tablet-drawer"
    class="hidden lg:hidden border-t border-theme-border/40 bg-theme-surface px-4 pt-4 pb-6 shadow-2xl transition-all"
  >
    <div class="mx-auto max-w-2xl space-y-5">
      <!-- Action Buttons Row (Install App + Support Developer) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <button
          type="button"
          aria-label={t('nav.installPwaAria')}
          class="install-pwa-trigger flex h-12 w-full items-center justify-center gap-2.5 rounded-xl border border-theme-border bg-theme-bg px-4 text-sm font-bold text-theme-text transition hover:border-[#2A835F] hover:bg-theme-pill"
        >
          <svg
            class="h-5 w-5 shrink-0 text-[#2A835F] dark:text-[#8BBB92]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12.01" y2="18"></line>
            <path d="M12 7v6"></path>
            <path d="M9.5 10.5 12 13l2.5-2.5"></path>
          </svg>
          <span>{t('nav.installPwa')}</span>
        </button>

        <a
          href="https://kisharadilshan.gumroad.com/coffee"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t('nav.supportDevAria')}
          class="btn-support-dev flex h-12 w-full items-center justify-center gap-2.5 rounded-xl px-4 text-sm font-bold shadow-sm"
        >
          <svg
            class="h-5 w-5 shrink-0 text-white"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
            <path d="M10 12.5c0-.8.7-1.5 1.5-1.5s1.5.7 1.5 1.5c0 1.5-3 3-3 3s-3-1.5-3-3c0-.8.7-1.5 1.5-1.5s1.5.7 1.5 1.5z" fill="currentColor" stroke="none"></path>
          </svg>
          <span>{t('nav.supportDev')}</span>
        </a>
      </div>

      <!-- 8-Language Selector Grid inside Mobile/Tablet Menu -->
      <div>
        <p class="mb-2.5 text-xs font-extrabold uppercase tracking-wider text-theme-textSecondary">
          {t('nav.languageAria')}
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          {
            Object.entries(languages).map(([code, info]) => {
              const isActive = code === lang;
              return (
                <a
                  href={getLocalizedPath(code as Locale)}
                  class:list={[
                    'flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-bold border transition-colors',
                    isActive
                      ? 'bg-[#2A835F] text-white border-[#2A835F]'
                      : 'bg-theme-bg/70 text-theme-text border-theme-border/40 hover:bg-theme-pill',
                  ]}
                >
                  <span class="flex items-center gap-2 truncate">
                    <span>{info.flag}</span>
                    <span class="truncate">{info.name}</span>
                  </span>
                  <span
                    class:list={[
                      'text-[11px] font-extrabold uppercase ml-1',
                      isActive ? 'text-white/90' : 'text-theme-textSecondary',
                    ]}
                  >
                    {info.code}
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</header>

<!-- PWA Install Guidance Modal (Fallback when native prompt is already installed or iOS/Safari) -->
<div
  id="pwa-install-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pwa-modal-title"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-[#092328]/75 p-4 backdrop-blur-sm"
>
  <div class="w-full max-w-md rounded-3xl border border-theme-border bg-theme-surface p-6 shadow-2xl">
    <div class="flex items-center gap-3.5 mb-3">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#2A835F] text-white">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M12 3v12"></path>
          <path d="m8 11 4 4 4-4"></path>
          <rect x="4" y="17" width="16" height="4" rx="1"></rect>
        </svg>
      </div>
      <h2 id="pwa-modal-title" class="text-xl font-extrabold text-theme-text">
        {t('nav.pwaModalTitle')}
      </h2>
    </div>
    <p class="text-base leading-relaxed text-theme-textSecondary mb-6">
      {t('nav.pwaModalDesc')}
    </p>
    <button
      type="button"
      id="pwa-modal-close"
      class="w-full rounded-xl bg-[#2A835F] py-3.5 text-base font-bold text-white transition hover:bg-[#12544F]"
    >
      {t('nav.pwaModalClose')}
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    // Theme toggle logic (supports both desktop and mobile/tablet buttons)
    const themeBtns = document.querySelectorAll('.theme-toggle-trigger');
    const sunIcons = document.querySelectorAll('.theme-icon-sun');
    const moonIcons = document.querySelectorAll('.theme-icon-moon');

    function syncThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      sunIcons.forEach((el) => el.classList.toggle('hidden', !isDark));
      moonIcons.forEach((el) => el.classList.toggle('hidden', isDark));
    }

    syncThemeIcons();

    themeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('webmtomp4-theme', isDark ? 'dark' : 'light');
        } catch (e) {}
        syncThemeIcons();
      });
    });

    // Mobile & Tablet Drawer Toggle Logic
    const mobileToggleBtn = document.getElementById('mobile-menu-toggle-btn');
    const mobileDrawer = document.getElementById('mobile-tablet-drawer');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');

    function closeMobileDrawer() {
      mobileDrawer?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileToggleBtn?.setAttribute('aria-expanded', 'false');
    }

    mobileToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = mobileDrawer?.classList.contains('hidden');
      if (isHidden) {
        mobileDrawer?.classList.remove('hidden');
        menuIconOpen?.classList.add('hidden');
        menuIconClose?.classList.remove('hidden');
        mobileToggleBtn?.setAttribute('aria-expanded', 'true');
      } else {
        closeMobileDrawer();
      }
    });

    // Desktop Language dropdown logic
    const langBtn = document.getElementById('lang-dropdown-btn');
    const langMenu = document.getElementById('lang-dropdown-menu');
    const langChevron = document.getElementById('lang-chevron');
    const langWrapper = document.getElementById('lang-dropdown-wrapper');

    function closeLangMenu() {
      langMenu?.classList.add('invisible', 'opacity-0', 'scale-95', 'pointer-events-none');
      langChevron?.classList.remove('rotate-180');
      langBtn?.setAttribute('aria-expanded', 'false');
    }

    function toggleLangMenu() {
      const isHidden = langMenu?.classList.contains('invisible');
      if (isHidden) {
        langMenu?.classList.remove('invisible', 'opacity-0', 'scale-95', 'pointer-events-none');
        langChevron?.classList.add('rotate-180');
        langBtn?.setAttribute('aria-expanded', 'true');
      } else {
        closeLangMenu();
      }
    }

    langBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleLangMenu();
    });

    document.addEventListener('click', (e) => {
      if (langWrapper && !langWrapper.contains(e.target)) {
        closeLangMenu();
      }
      if (
        mobileDrawer &&
        !mobileDrawer.classList.contains('hidden') &&
        !mobileDrawer.contains(e.target) &&
        !mobileToggleBtn?.contains(e.target)
      ) {
        closeMobileDrawer();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLangMenu();
        closeMobileDrawer();
        pwaModal?.classList.add('hidden');
        pwaModal?.classList.remove('flex');
      }
    });

    // Install PWA ("Add to Home Screen") logic for both Desktop and Mobile/Tablet triggers
    let deferredPrompt = null;
    const installBtns = document.querySelectorAll('.install-pwa-trigger');
    const pwaModal = document.getElementById('pwa-install-modal');
    const pwaModalClose = document.getElementById('pwa-modal-close');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    installBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        closeMobileDrawer();
        if (deferredPrompt) {
          deferredPrompt.prompt();
          await deferredPrompt.userChoice;
          deferredPrompt = null;
        } else {
          pwaModal?.classList.remove('hidden');
          pwaModal?.classList.add('flex');
        }
      });
    });

    pwaModalClose?.addEventListener('click', () => {
      pwaModal?.classList.add('hidden');
      pwaModal?.classList.remove('flex');
    });

    pwaModal?.addEventListener('click', (e) => {
      if (e.target === pwaModal) {
        pwaModal.classList.add('hidden');
        pwaModal.classList.remove('flex');
      }
    });

    // Register Service Worker for PWA
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  })();
</script>
